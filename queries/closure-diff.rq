# Closure diff between two snapshots, restricted to the runtime closure:
# outputs in A's runtime closure that are not in B's, with their derivation.
# Needs the core pack (runtimeClosureContains) and built outputs (references).
# Set difference as subquery + MINUS (see QUERIES.md): a correlated
# FILTER NOT EXISTS over a large closure is orders of magnitude slower.
SELECT ?storePath ?drvName WHERE {
  { SELECT DISTINCT ?out WHERE {
      VALUES ?a { <https://w3id.org/nix/id/gen/AAAA> }
      ?a nix:runtimeClosureContains ?out .
  } }
  MINUS {
      VALUES ?b { <https://w3id.org/nix/id/gen/BBBB> }
      ?b nix:runtimeClosureContains ?out .
  }
  ?out nix:storePath ?storePath .
  OPTIONAL { ?drv nix:hasOutput ?out . ?drv nix:name ?drvName }
}
ORDER BY ?storePath
