# What is running this image digest right now, anywhere: latest live snapshot
# per cluster, workloads whose containers run the digest.
SELECT ?cluster ?workload ?observedAt WHERE {
  VALUES ?image { <https://w3id.org/nix2rdf/id/oci/sha256/1111111111111111111111111111111111111111111111111111111111111111> }
  ?container k8s:runsImage ?image .
  GRAPH ?snap { ?workload k8s:hasContainer ?container }
  ?snap k8s:snapshotKind k8s:liveState .
  ?snap k8s:ofCluster ?cluster .
  ?snap k8s:observedAt ?observedAt .
  FILTER NOT EXISTS {
    ?newer k8s:ofCluster ?cluster . ?newer k8s:snapshotKind k8s:liveState .
    ?newer k8s:observedAt ?t2 . FILTER(?t2 > ?observedAt)
  }
}
