RewriteEngine On
Options +FollowSymLinks

# Versioned documents: https://w3id.org/nix/ontology/<semver>
RewriteRule ^ontology/([0-9.]+)$ https://samrose.github.io/nix-ontology/versions/$1/ns.ttl [R=302,L]
RewriteRule ^k8s/([0-9.]+)$ https://samrose.github.io/nix-ontology/versions/$1/k8s.ttl [R=302,L]

# Namespace documents: Turtle for machines, HTML for humans
RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^ns$ https://samrose.github.io/nix-ontology/ns.ttl [R=303,L]
RewriteRule ^ns$ https://samrose.github.io/nix-ontology/ns.html [R=303,L]

RewriteCond %{HTTP_ACCEPT} text/turtle [OR]
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml [OR]
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^k8s$ https://samrose.github.io/nix-ontology/k8s.ttl [R=303,L]
RewriteRule ^k8s$ https://samrose.github.io/nix-ontology/k8s.html [R=303,L]

# Instance IRIs (https://w3id.org/nix/id/...) and everything else: the docs.
RewriteRule ^(.*)$ https://samrose.github.io/nix-ontology/$1 [R=302,L]
